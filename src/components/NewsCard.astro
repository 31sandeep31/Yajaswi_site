---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '../lib/content';

interface Props {
  item: CollectionEntry<'news'>;
}

const { item } = Astro.props;
const { title, date, summary, lang, cover, source } = item.data;
---

<article class="ncard" lang={lang}>
  {cover && (
    <a href={`/news/${item.id}/`} class="cover" tabindex="-1" aria-hidden="true">
      <img src={cover} alt="" loading="lazy" />
    </a>
  )}
  <div class="body">
    <p class="meta">
      <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
      {source && <span>· {source}</span>}
    </p>
    <h3><a href={`/news/${item.id}/`}>{title}</a></h3>
    <p class="summary">{summary}</p>
    <a class="link-arrow" href={`/news/${item.id}/`}>{lang === 'ne' ? 'पूरा पढ्नुहोस्' : 'Read more'}</a>
  </div>
</article>

<style>
  .ncard {
    background: var(--card);
    border: 1px solid var(--line);
    border-top: 3px solid var(--red);
    border-radius: var(--radius);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: box-shadow 0.2s, transform 0.2s;
  }
  .ncard:hover { box-shadow: var(--shadow); transform: translateY(-2px); }
  .cover { display: block; aspect-ratio: 16 / 9; overflow: hidden; }
  .cover img { width: 100%; height: 100%; object-fit: cover; }
  .body { padding: 1.2rem 1.3rem 1.4rem; display: flex; flex-direction: column; flex: 1; }
  .meta { font-size: 0.875rem; color: var(--ink-3); margin-bottom: 0.4rem; }
  h3 { font-size: 1.25rem; margin: 0 0 0.5rem; }
  h3 a { text-decoration: none; }
  .summary {
    color: var(--ink-2);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .link-arrow { margin-top: auto; color: var(--red); font-size: 0.95rem; }
</style>
