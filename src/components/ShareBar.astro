---
interface Props {
  title: string;
  /** Path of the page being shared; defaults to the current page. */
  path?: string;
}

const { title, path = Astro.url.pathname } = Astro.props;
const url = new URL(path, Astro.site).toString();
const u = encodeURIComponent(url);
const t = encodeURIComponent(title);

const targets = [
  { name: 'Facebook', href: `https://www.facebook.com/sharer/sharer.php?u=${u}`, icon: 'M14 8.5V6.8c0-.8.2-1.3 1.4-1.3H17V2.6c-.3 0-1.3-.1-2.4-.1-2.4 0-4 1.4-4 4.1v1.9H8v3.2h2.6V20h3.4v-8.3h2.6l.4-3.2z' },
  { name: 'WhatsApp', href: `https://wa.me/?text=${t}%20${u}`, icon: 'M12 2.5a9.4 9.4 0 0 0-8 14.3L3 21l4.3-1.1A9.4 9.4 0 1 0 12 2.5Zm5.5 13.3c-.2.6-1.3 1.2-1.8 1.3-.5 0-1 .2-3.3-.7a11.5 11.5 0 0 1-4.5-4c-.3-.5-1.2-1.6-1.2-3s.8-2.2 1-2.5c.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5l.9 2.1c0 .2.1.4 0 .6l-.4.6-.5.5c-.1.2-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.1 1 2.1 1.3 2.4 1.5.3.1.5.1.7-.1l.9-1.1c.2-.3.4-.2.7-.1l2 1c.3.1.5.2.6.3 0 .2 0 .8-.1 1.3Z' },
  { name: 'Viber', href: `viber://forward?text=${t}%20${u}`, icon: 'M12 2C6.9 2 3.5 4.3 3.5 10.2c0 3.2 1 5.3 2.8 6.6V21l3-2.4c.9.2 1.8.3 2.7.3 5.1 0 8.5-2.3 8.5-8.7S17.1 2 12 2Zm3.8 12.7c-.4.6-1.2 1-1.9.8-2.6-.8-4.7-2.9-5.5-5.5-.2-.7.2-1.5.8-1.9.4-.2.9-.1 1.1.3l.7 1.1c.2.4.1.9-.3 1.1l-.3.2c.5 1.1 1.4 2 2.5 2.5l.2-.3c.3-.4.8-.5 1.1-.3l1.1.7c.5.3.6.8.5 1.3Z' },
  { name: 'X', href: `https://twitter.com/intent/tweet?text=${t}&url=${u}`, icon: 'M17.8 3h3L14.2 10.5 22 21h-6.1l-4.8-6.3L5.6 21h-3l7-8L2 3h6.3l4.3 5.7L17.8 3Zm-1 16.2h1.7L7.3 4.7H5.5l11.3 14.5Z' },
  { name: 'LinkedIn', href: `https://www.linkedin.com/sharing/share-offsite/?url=${u}`, icon: 'M6.9 8.8H3.6V20h3.3V8.8ZM5.2 3.5a2 2 0 1 0 0 4 2 2 0 0 0 0-4ZM20.4 13.6c0-3-.7-5.1-4.1-5.1-1.7 0-2.8.9-3.2 1.8V8.8H9.9V20h3.3v-5.6c0-1.5.3-2.9 2.1-2.9 1.8 0 1.8 1.7 1.8 3V20h3.3v-6.4Z' },
  { name: 'Telegram', href: `https://t.me/share/url?url=${u}&text=${t}`, icon: 'M21.4 4.2 2.9 11.3c-1.3.5-1.2 1.2-.2 1.5l4.7 1.5 1.8 5.6c.2.6.4.8.8.8s.6-.2.9-.5l2.3-2.2 4.7 3.5c.9.5 1.5.2 1.7-.8l3.1-14.6c.3-1.3-.5-1.8-1.3-1.5ZM9.6 14.1l8.9-5.6c.4-.3.8-.1.5.2l-7.6 6.9-.3 3.2-1.5-4.7Z' },
];
---

<div class="share" data-share data-url={url} data-title={title}>
  <span class="share-label"><span lang="ne">सेयर गर्नुहोस्</span> · Share</span>
  <div class="share-row">
    <button type="button" class="share-btn share-native" data-native hidden>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 7.5 7.5l1.4 1.4L11 6.8V15h2V6.8l2.1 2.1 1.4-1.4L12 3ZM5 13v6.5c0 .8.7 1.5 1.5 1.5h11c.8 0 1.5-.7 1.5-1.5V13h-2v6H7v-6H5Z" /></svg>
      <span>Share…</span>
    </button>
    {targets.map((s) => (
      <a class="share-btn" href={s.href} target="_blank" rel="noopener" aria-label={`Share on ${s.name}`} title={s.name}>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d={s.icon} /></svg>
      </a>
    ))}
    <button type="button" class="share-btn" data-copy aria-label="Copy link" title="Copy link">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10.6 13.4a1 1 0 0 1 0-1.4l3.5-3.5a1 1 0 1 1 1.4 1.4L12 13.4a1 1 0 0 1-1.4 0Zm-2.8 5.7a4 4 0 0 1-2.9-6.8l2.2-2.2 1.4 1.4-2.2 2.2a2 2 0 0 0 2.8 2.9l2.2-2.2 1.5 1.4-2.2 2.2a4 4 0 0 1-2.8 1.1Zm8.4-5.3-1.4-1.4 2.2-2.2a2 2 0 1 0-2.8-2.9L12 9.5l-1.5-1.4 2.2-2.2a4 4 0 0 1 5.7 5.7l-2.2 2.2Z" /></svg>
      <span class="copy-done" hidden>Copied!</span>
    </button>
  </div>
</div>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-share]')) {
    const { url = '', title = '' } = el.dataset;
    const native = el.querySelector<HTMLButtonElement>('[data-native]');
    if (native && 'share' in navigator) {
      native.hidden = false;
      native.addEventListener('click', () => navigator.share({ title, url }).catch(() => {}));
    }
    const copy = el.querySelector<HTMLButtonElement>('[data-copy]');
    copy?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(url);
        const done = copy.querySelector<HTMLElement>('.copy-done');
        if (!done) return;
        done.hidden = false;
        setTimeout(() => (done.hidden = true), 1800);
      } catch {
        window.prompt('Copy this link:', url);
      }
    });
  }
</script>

<style>
  .share { display: grid; gap: 0.6rem; }
  .share-label { font-size: 0.85rem; font-weight: 700; color: var(--ink-3); }
  .share-row { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .share-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    min-width: 42px;
    height: 42px;
    padding: 0 0.6rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    font: 600 0.9rem var(--font-body);
    cursor: pointer;
    transition: background 0.15s, color 0.15s, border-color 0.15s;
  }
  .share-btn:hover { background: var(--red); border-color: var(--red); color: #fff; }
  .share-btn svg { width: 19px; height: 19px; fill: currentColor; }
  .share-native { background: var(--ink); color: var(--paper); border-color: var(--ink); padding-inline: 1rem; }
  .copy-done {
    position: absolute;
    bottom: calc(100% + 6px);
    left: 50%;
    transform: translateX(-50%);
    background: var(--ink);
    color: #fff;
    font-size: 0.75rem;
    padding: 0.2rem 0.5rem;
    border-radius: 6px;
    white-space: nowrap;
  }
  /* viber:// only opens where the app is installed — hide it on desktop */
  @media (hover: hover) and (pointer: fine) {
    .share-btn[href^='viber'] { display: none; }
  }
</style>
