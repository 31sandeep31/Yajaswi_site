---
import '../styles/global.css';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
  /** Absolute URL or site-relative path for the social preview image. */
  image?: string;
  type?: 'website' | 'article' | 'video.other';
  lang?: 'ne' | 'en';
  publishedTime?: Date;
}

const {
  title,
  description = `${site.nameNe} (${site.name}) — ${site.taglineNe}. ${site.campaign.headlineEn}.`,
  image = '/og-default.jpg',
  type = 'website',
  lang = 'en',
  publishedTime,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.nameNe} ${site.name}` : `${site.nameNe} · ${site.name}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
const path = Astro.url.pathname;

const nav = [
  { href: '/about/', ne: 'परिचय', en: 'About' },
  { href: '/news/', ne: 'समाचार', en: 'News' },
  { href: '/videos/', ne: 'भिडियो', en: 'Videos' },
  { href: '#contact', ne: 'सम्पर्क', en: 'Contact' },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} — News`} href="/rss.xml" />
    <meta name="theme-color" content="#b3122a" />

    <meta property="og:site_name" content={`${site.nameNe} · ${site.name}`} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title ?? `${site.nameNe} · ${site.name}`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'ne' ? 'ne_NP' : 'en_US'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ?? site.name} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Home">
          <span class="brand-ne" lang="ne">{site.nameNe}</span>
          <span class="brand-en">{site.name}</span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map((item) => (
              <li>
                <a
                  href={item.href}
                  aria-current={path.startsWith(item.href) ? 'page' : undefined}
                >
                  <span lang="ne">{item.ne}</span>
                  <span class="nav-en">{item.en}</span>
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer" id="contact">
      <div class="wrap footer-grid">
        <div>
          <p class="foot-name deva-display" lang="ne">{site.nameNe}</p>
          <p class="foot-role">{site.tagline}</p>
          {site.campaign.active && (
            <p class="foot-campaign" lang="ne">
              {site.campaign.eyebrowNe} — {site.campaign.headlineNe}
              <br />
              {site.campaign.closingNe}
            </p>
          )}
        </div>
        <div>
          <h2 class="foot-h">सम्पर्क · Contact</h2>
          <ul class="foot-list">
            <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
            {site.social.map((s) => (
              <li><a href={s.url} rel="me noopener" target="_blank">{s.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h2 class="foot-h">अपडेट रहनुहोस् · Stay updated</h2>
          <p class="foot-note">
            Follow on Facebook, or subscribe to the <a href="/rss.xml">news feed</a> to hear about every new
            update.
          </p>
          <a class="btn btn--red" href={site.social[0]?.url} target="_blank" rel="noopener">Follow on Facebook</a>
        </div>
      </div>
      <div class="wrap foot-base">© {new Date().getFullYear()} {site.name}</div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(248 244 238 / 0.9);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 64px;
  }
  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.1;
  }
  .brand-ne {
    font: 700 1.25rem/1.2 var(--font-deva-display);
    color: var(--ink);
  }
  .brand-en {
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--red);
    font-weight: 700;
  }
  nav ul {
    display: flex;
    gap: clamp(0.25rem, 2vw, 1.75rem);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0.35rem 0.4rem;
    text-decoration: none;
    font-weight: 600;
    line-height: 1.15;
    border-bottom: 2px solid transparent;
  }
  nav a[aria-current='page'] { border-color: var(--red); }
  .nav-en {
    font-size: 0.7rem;
    font-weight: 500;
    color: var(--ink-3);
    letter-spacing: 0.04em;
  }
  @media (max-width: 520px) {
    .brand-en { display: none; }
    .nav-en { display: none; }
    nav a { font-size: 0.95rem; padding-inline: 0.3rem; }
  }

  .site-footer {
    background: var(--ink);
    color: #e9e2d8;
    padding-top: clamp(48px, 7vw, 80px);
  }
  .site-footer a { color: #fff; }
  .site-footer a:hover { color: #ffb3bd; }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr));
  }
  .foot-name { font-size: 1.75rem; margin: 0; color: #fff; }
  .foot-role { color: #b9afa3; margin: 0 0 1rem; }
  .foot-campaign { color: #ffcdd3; font-weight: 500; }
  .foot-h {
    font: 700 0.85rem/1.4 var(--font-body);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #b9afa3;
    margin-bottom: 0.9rem;
  }
  .foot-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .foot-note { color: #cfc6ba; }
  .foot-base {
    margin-top: 3rem;
    padding-block: 1.25rem;
    border-top: 1px solid #3a342e;
    font-size: 0.875rem;
    color: #8f867b;
  }
</style>
