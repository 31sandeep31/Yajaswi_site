---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ShareBar from '../../components/ShareBar.astro';
import NewsCard from '../../components/NewsCard.astro';
import { formatDate, getNews } from '../../lib/content';

export async function getStaticPaths() {
  const news = await getNews();
  return news.map((item) => ({
    params: { id: item.id },
    props: { item, more: news.filter((n) => n.id !== item.id).slice(0, 3) },
  }));
}

const { item, more } = Astro.props;
const { title, date, summary, lang, cover, source, sourceUrl, tags } = item.data;
const { Content } = await render(item);
---

<Base title={title} description={summary} image={cover} type="article" lang={lang} publishedTime={date}>
  <article class="section">
    <div class="wrap narrow">
      <a class="back" href="/news/">← {lang === 'ne' ? 'सबै समाचार' : 'All news'}</a>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date, lang)}</time>
        {source && <span> · {source}</span>}
      </p>
      <h1>{title}</h1>
      <p class="lede">{summary}</p>
      <ShareBar title={title} />
      {cover && <img class="cover" src={cover} alt="" />}
      <div class="prose body">
        <Content />
      </div>
      {sourceUrl && (
        <p>
          <a class="btn" href={sourceUrl} target="_blank" rel="noopener">
            {lang === 'ne' ? 'मूल समाचार पढ्नुहोस्' : 'Read the original'} ↗
          </a>
        </p>
      )}
      {tags.length > 0 && <p class="tags">{tags.map((t) => <span class="tag">{t}</span>)}</p>}
      <div class="end-share">
        <ShareBar title={title} />
      </div>
    </div>
  </article>

  {more.length > 0 && (
    <section class="section section--tint">
      <div class="wrap">
        <div class="section-head"><h2 lang="ne">थप समाचार</h2></div>
        <div class="grid grid--3">{more.map((n) => <NewsCard item={n} />)}</div>
      </div>
    </section>
  )}
</Base>

<style>
  .narrow { max-width: 820px; }
  .back { display: inline-block; text-decoration: none; font-weight: 600; color: var(--ink-3); margin-bottom: 1.5rem; }
  .meta { color: var(--ink-3); margin-bottom: 0.5rem; }
  h1 { font-size: clamp(1.9rem, 4.6vw, 3rem); }
  .lede { font-size: 1.25rem; color: var(--ink-2); line-height: 1.7; margin-bottom: 1.5rem; }
  .cover { width: 100%; border-radius: var(--radius); margin-top: 2rem; }
  .body { margin-top: 2.25rem; }
  .tags { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .end-share { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
</style>
