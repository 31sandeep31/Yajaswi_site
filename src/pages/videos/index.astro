---
import Base from '../../layouts/Base.astro';
import VideoCard from '../../components/VideoCard.astro';
import { getVideos, videoCategories } from '../../lib/content';

const videos = await getVideos();
const used = Object.entries(videoCategories).filter(([key]) => videos.some((v) => v.data.category === key));
---

<Base title="Videos · भिडियो" description="Interviews, talks and films featuring Yajaswi Rai.">
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">Videos</p>
          <h1>Interviews, talks & films</h1>
        </div>
      </div>
      <div class="filters" role="group" aria-label="Filter videos">
        <button type="button" data-filter="all" aria-pressed="true">All</button>
        {used.map(([key, label]) => (
          <button type="button" data-filter={key} aria-pressed="false">{label.en}</button>
        ))}
      </div>
      <div class="grid grid--3">
        {videos.map((v) => (
          <div data-cat={v.data.category}><VideoCard video={v} /></div>
        ))}
      </div>
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const items = document.querySelectorAll<HTMLElement>('[data-cat]');
  for (const btn of buttons) {
    btn.addEventListener('click', () => {
      const f = btn.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      items.forEach((el) => (el.hidden = f !== 'all' && el.dataset.cat !== f));
    });
  }
</script>

<style>
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin: 0; }
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1.75rem; }
  .filters button {
    font: 600 0.95rem var(--font-body);
    padding: 0.45rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--card);
    color: var(--ink);
    cursor: pointer;
  }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  [data-cat] { display: flex; }
  [data-cat] > :global(*) { flex: 1; }
  [data-cat][hidden] { display: none; }
</style>
